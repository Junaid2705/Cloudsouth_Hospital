{
	"info": {
		"_postman_id": "c7a8b9f0-e123-4567-89ab-cloudsouthtest01",
		"name": "CloudSouth Hospital API Test Suite (Automated)",
		"description": "Automated Postman test suite with JavaScript assertions for CloudSouth Hospital Management backend. Aligned with BRD v1.0 and FRD v1.0.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api/v1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"item": [
				{
					"name": "TC_SYS_001 - Check System Health",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success = true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"System indicates up and running\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.include(\"System is up and running\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					}
				}
			]
		},
		{
			"name": "2. Departments",
			"item": [
				{
					"name": "TC_DEP_001 - Get All 5 Hospital Departments",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Contains all 5 standard departments from BRD\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.data.length).to.be.at.least(5);",
									"    ",
									"    var codes = jsonData.data.map(function(d) { return d.code; });",
									"    pm.expect(codes).to.include.members([\"GEN\", \"ORTHO\", \"NEURO\", \"ONCO\", \"GASTRO\"]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/departments",
							"host": ["{{baseUrl}}"],
							"path": ["departments"]
						}
					}
				},
				{
					"name": "TC_DEP_002 - Get Department By ID (General Physicians)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Department 1 is General Physicians with 35 doctors\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.name).to.eql(\"General Physicians\");",
									"    pm.expect(jsonData.data.code).to.eql(\"GEN\");",
									"    pm.expect(jsonData.data.totalDoctors).to.eql(35);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/departments/1",
							"host": ["{{baseUrl}}"],
							"path": ["departments", "1"]
						}
					}
				},
				{
					"name": "TC_DEP_003 - Negative: Department Not Found",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Returns error message in ApiResponse\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.message).to.include(\"not found\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/departments/9999",
							"host": ["{{baseUrl}}"],
							"path": ["departments", "9999"]
						}
					}
				},
				{
					"name": "TC_DEP_004 - Get Doctors In Department",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Returns doctors assigned to Department 1\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.data.length).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/departments/1/doctors",
							"host": ["{{baseUrl}}"],
							"path": ["departments", "1", "doctors"]
						}
					}
				}
			]
		},
		{
			"name": "3. Doctors Directory & Search",
			"item": [
				{
					"name": "TC_DOC_001 - Get All Doctors with $50 Standard Fee",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"All doctors have standard $50.00 fee\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.data[0].consultationFee).to.eql(50.0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/doctors",
							"host": ["{{baseUrl}}"],
							"path": ["doctors"]
						}
					}
				},
				{
					"name": "TC_DOC_002 - Search Doctors by Keyword (brain)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Search returns Dr. Alan Vance (Neurosurgery)\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.data[0].name).to.include(\"Dr. Alan Vance\");",
									"    pm.expect(jsonData.data[0].department).to.include(\"Neurosurgery\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/doctors/search?query=brain",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "search"],
							"query": [
								{
									"key": "query",
									"value": "brain"
								}
							]
						}
					}
				},
				{
					"name": "TC_DOC_005 - Negative: Doctor Not Found",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Returns doctor not found error\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/doctors/9999",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "9999"]
						}
					}
				}
			]
		},
		{
			"name": "4. Doctor Availability & Scheduling",
			"item": [
				{
					"name": "TC_AV_001 - Check Doctor Availability for Future Date",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Doctor is available with time slots and $50 fee\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.available).to.eql(true);",
									"    pm.expect(jsonData.data.consultationFee).to.eql(50.0);",
									"    pm.expect(jsonData.data.availableSlots).to.be.an('array');",
									"    pm.expect(jsonData.data.availableSlots.length).to.be.above(0);",
									"    pm.expect(jsonData.data.availableSlots[0]).to.have.property('slot');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/doctors/1/availability?date=2026-10-22",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1", "availability"],
							"query": [
								{
									"key": "date",
									"value": "2026-10-22"
								}
							]
						}
					}
				},
				{
					"name": "TC_AV_002 - Negative: Past Date Availability Blocked",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Past date correctly returns available = false\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.available).to.eql(false);",
									"    pm.expect(jsonData.data.message).to.include(\"past dates\");",
									"    pm.expect(jsonData.data.availableSlots.length).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/doctors/1/availability?date=2020-01-01",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1", "availability"],
							"query": [
								{
									"key": "date",
									"value": "2020-01-01"
								}
							]
						}
					}
				},
				{
					"name": "TC_AV_005 - Get Doctor Recurring Schedules",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Doctor has recurring schedules configured\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.data.length).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/doctors/1/schedules",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1", "schedules"]
						}
					}
				}
			]
		},
		{
			"name": "5. Patient Registration & 10% Discount",
			"item": [
				{
					"name": "TC_PAT_001 - Register New First-Time Patient",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"First-time patient is NOT marked as returning\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.isReturningPatient).to.eql(false);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Alice\",\n    \"lastName\": \"Smith\",\n    \"email\": \"alice.qa@example.com\",\n    \"phone\": \"+1-555-0199\",\n    \"bloodGroup\": \"O+\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/patients",
							"host": ["{{baseUrl}}"],
							"path": ["patients"]
						}
					}
				},
				{
					"name": "TC_PAT_002 - Returning Patient Unlocks 10% Discount ($45 Fee)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"System detects returning patient and sets isReturningPatient = true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.isReturningPatient).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Alice\",\n    \"lastName\": \"Smith\",\n    \"email\": \"alice.qa@example.com\",\n    \"phone\": \"+1-555-0199\",\n    \"bloodGroup\": \"O+\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/patients",
							"host": ["{{baseUrl}}"],
							"path": ["patients"]
						}
					}
				}
			]
		}
	]
}
